# NEVER commit a real API key (placez votre cle uniquement dans .env local, jamais dans Git)
#
# --- Images /generate-visuals : MODE DEMO GRATUIT (recommande) ---
# FASHION_ORACLE_IMAGE_PROVIDER=demo   (0 appel externe image, 0 cout, 0 timeout fournisseur)
# En demo: visuels locaux statiques + revele progressif pour UX IA.
#
# --- Option Replicate (payant) si vous voulez re-activer plus tard ---
# FASHION_ORACLE_IMAGE_PROVIDER=demo_local_year
# IMAGE_PROVIDER=demo_local_year
# Mode simulateur local par annee: 3 visuels generes localement (deterministes), sans API payante.
# (alias supporté : IMAGE_PROVIDER si vous ne voulez pas préfixer)
#
# FASHION_ORACLE_IMAGE_PROVIDER=replicate   (obligatoire ; vide -> missing_image_provider)
# FASHION_ORACLE_IMAGE_MODEL=owner/model ou owner/model:version_id   (obligatoire ; vide -> missing_image_model_config)
#   L API Replicate attend en pratique owner/model:hash64 (hash = latest_version.id sur replicate.com).
# FASHION_ORACLE_REPLICATE_API_TOKEN=r8_...   (obligatoire en mode replicate ; sinon missing_replicate_api_token)
# FASHION_ORACLE_REPLICATE_MIN_INTERVAL_S=2.0   (anti-429 ; defaut backend 2.0)
# Ne pas utiliser FASHION_ORACLE_MODEL ici : reserve au texte OpenRouter.
#
# Exemple SDXL :
# FASHION_ORACLE_IMAGE_PROVIDER=replicate
# FASHION_ORACLE_IMAGE_MODEL=stability-ai/sdxl:7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd46c929f9bdc
# FASHION_ORACLE_REPLICATE_API_TOKEN=r8_...
# FASHION_ORACLE_REPLICATE_MIN_INTERVAL_S=2.0
# Port annonce dans /health (uvicorn ne met pas toujours PORT dans l env) :
# FASHION_ORACLE_HTTP_PORT=8010
# Diagnostic Replicate : force flux-schnell + prompt minimal (token / reseau) :
# FASHION_ORACLE_REPLICATE_DIAG_SAFE_RUN=0
# FASHION_ORACLE_REPLICATE_DIAG_MODEL=black-forest-labs/flux-schnell:5d891b49a17e1cdd6786d441e1e3a2f0f76daeeee0c59868bd598b4951d3c58a
# Si stability-ai/sdxl echoue (erreur modele/version/payload 4xx, ModelError, etc.) : un seul essai flux-schnell.
# Si flux echoue aussi : erreur structuree image_generation_unavailable (UI stable).
# Ref flux (owner/model:hash) ; vide ou absent = defaut interne black-forest-labs/flux-schnell:5d891b49...
# FASHION_ORACLE_REPLICATE_FLUX_FALLBACK_REF=black-forest-labs/flux-schnell:...
#
# Si openai : uniquement OPENAI_API_KEY — le token Replicate n est pas lu.
# Autre valeur provider -> invalid_image_provider
# Pipeline : FASHION_ORACLE_REPLICATE_GEN_TIMEOUT_S=40 (par appel run+download), FASHION_ORACLE_PER_CONCEPT_TIMEOUT_S=150
# semaphore=2 (code)
# SDXL carre (cote px, multiple de 64) : FASHION_ORACLE_SDXL_SIDE_PX=768
# guidance 1–50 (defaut 7.5) ; 0 est refuse par l API Replicate SDXL
# FASHION_ORACLE_SDXL_GUIDANCE_SCALE=7.5
# FASHION_ORACLE_REPLICATE_STEPS=4
# Demo rapide : FASHION_ORACLE_IMAGE_FAST_DEMO=1
# Prechauffage apres /predict : FASHION_ORACLE_PREWARM_AFTER_PREDICT=0
#
# OpenAI : https://api.openai.com/v1 , modele image gpt-image-1
# FASHION_ORACLE_IMAGE_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- OpenRouter : texte / simulateur cout uniquement (FASHION_ORACLE_BASE_URL + cle sk-or-...) ---
FASHION_ORACLE_API_KEY=replace_me
FASHION_ORACLE_MODEL=openai/gpt-4o-mini
FASHION_ORACLE_BASE_URL=https://openrouter.ai/api/v1

# Optionnel : modele OpenRouter dedie au simulateur de couts (sinon FASHION_ORACLE_MODEL)
# FASHION_ORACLE_COST_MODEL=openai/gpt-4o-mini

# Port HTTP du backend (defaut 8010). Si demarrage impossible (WinError 10013 : port occupe ou reserve),
# mettez 8011 ici ET la meme variable d'environnement FASHION_ORACLE_PORT pour l'appli Qt.
# FASHION_ORACLE_PORT=8011
#
# Optionnel : URL absolue pour les fichiers /static/generated/ (sinon derivee de chaque requete HTTP).
# FASHION_ORACLE_PUBLIC_URL=http://127.0.0.1:8011
#
# Capsule : timeout par slot en secondes (telechargement inclus). Defaut 165 pour laisser Pollinations finir.
# FASHION_ORACLE_CAPSULE_SLOT_TIMEOUT_S=165
#
# 1 = capsule sans Replicate/OpenRouter (defaut, plus rapide). 0 = pipeline complet (plus lent, souvent meilleure image).
# FASHION_ORACLE_CAPSULE_FAST=1
#
# 1 = generer les 3 images une par une (defaut, plus fiable). 0 = tout en parallele (plus risque timeout).
# FASHION_ORACLE_CAPSULE_FAST_SERIAL=1
#
# Images plus legeres / rapides (multiple de 64, ex. 384 ou 448).
# FASHION_ORACLE_IMAGE_EDGE_PX=448
#
# Replicate flux-schnell : moins de pas = plus rapide (1..12).
# FASHION_ORACLE_REPLICATE_STEPS=3
#
# Simulateur de Cout Avance (API metier, hors CRUD) — remplacer le port si besoin :
# GET  http://127.0.0.1:8010/cost/health
# POST http://127.0.0.1:8010/cost/simulate
# POST http://127.0.0.1:8010/cost/optimize
# Exemple Flux (ref complete dans une seule variable) :
# FASHION_ORACLE_IMAGE_MODEL=black-forest-labs/flux-schnell:<hash_page_Replicate>
FASHION_ORACLE_DB=sqlite:///./fashion_oracle.db
