  <property name="styleSheet">
   <string notr="true">
    /* --- STRUCTURE GLOBALE --- */
    QMainWindow, QWidget#centralwidget { background-color: #f3f0eb; font-family: "Segoe UI"; color: #3e2723; }

    /* --- SIDEBAR (FIXE ET FINE) --- */
    QFrame#frame_sidebar {
        background-color: #1a1210; /* Noir/Marron très profond */
        border-right: 1px solid #3e2723;
        min-width: 240px;
        max-width: 240px; /* --- CECI EMPÊCHE L'ÉLARGISSEMENT */
    }

    /* LOGO HEADER */
    QWidget#widget_logo_container {
        background-color: #2c1a16;
        border-bottom: 2px solid #8d5524;
    }
    QLabel#l_app_title {
        color: #e0c097; /* Or pâle */
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 2px;
        font-family: "Segoe UI";
        text-transform: uppercase;
    }

    /* MENU NAVIGATION */
    QPushButton.nav_btn {
        text-align: left;
        padding: 18px 25px;
        border: none;
        background: transparent;
        color: #aca09d;
        font-weight: 600;
        font-size: 14px;
    }
    QPushButton.nav_btn:hover {
        background-color: #3e2723;
        color: #fff;
        border-left: 4px solid #d4af37; /* Liseré Or */
        padding-left: 29px; /* Animation décalage */
    }

    /* --- PAGE D'ACCUEIL (LUXE / MODERNE) --- */
    /* Fond dégradé subtil */
    QWidget#page_home {
        background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #2c1a16, stop:1 #1a1210);
    }

    /* Titre Principal */
    QLabel#lbl_welcome_title {
        font-size: 56px;
        font-weight: 300; /* Light font = Modernité */
        color: #ffffff;
        letter-spacing: 2px;
    }
    /* Sous-titre */
    QLabel#lbl_welcome_sub {
        font-size: 22px;
        color: #d4af37; /* Or */
        font-style: italic;
        margin-bottom: 50px;
    }

    /* Bouton Central "Hero" */
    QPushButton#btn_start_app {
        background-color: transparent;
        color: #d4af37;
        font-size: 18px;
        font-weight: bold;
        padding: 15px 50px;
        border: 2px solid #d4af37;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    QPushButton#btn_start_app:hover {
        background-color: #d4af37;
        color: #1a1210;
    }

    /* --- RESTE DE L'INTERFACE (TABLEAUX, ETC.) --- */
    QTableWidget { background-color: #ffffff; gridline-color: #ecf0f1; border: 1px solid #dcdcdc; border-radius: 4px; }
    QHeaderView::section { background-color: #2c1a16; color: #e0c097; padding: 12px; border: none; font-weight: bold; text-transform: uppercase; }
    QTableWidget::item { border-bottom: 1px solid #f0f0f0; padding: 5px; }
    QTableWidget#tableTimeline::item { background-color: transparent; border: 0px; }

    /* BOUTONS ACTIONS */
    QPushButton { border-radius: 4px; padding: 8px 16px; font-weight: bold; border: none; }
    QPushButton#btn_to_add_planif, QPushButton#btn_valider_planif, QPushButton#btn_calculer_ia, QPushButton#btn_valider_etape {
        background-color: #8d5524; color: white;
    }
    QPushButton#btn_to_add_planif:hover { background-color: #a0673b; }

    QPushButton#btn_rechercher, QPushButton#btn_tri, QPushButton#btn_stat_plan, QPushButton#btn_modifier_planif, QPushButton#btn_pdf, QPushButton#btn_back_planif, QPushButton#btn_back_fab, QPushButton#btn_back_stats, QPushButton#btn_refresh_timeline {
        background-color: #795548; color: white; /* Marron moyen */
    }
    QPushButton#btn_check_delta, QPushButton#btn_supprimer_planif { background-color: #b71c1c; color: white; }

    QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
        background: #ffffff; border: 1px solid #ccc; padding: 8px; border-radius: 4px; color: #333;
    }
    QFrame#frame_supervision { background-color: #fff; border: 1px solid #ddd; border-left: 5px solid #8d5524; }

    /* STATS */
    QFrame.stat_card { background-color: white; border-radius: 8px; border-bottom: 4px solid #d4af37; }
    QLabel.stat_val { font-size: 40px; font-weight: bold; color: #2c1a16; }
    QProgressBar { border: 1px solid #ddd; border-radius: 4px; text-align: center; background: #eee; color:#000; }
    QProgressBar::chunk { background-color: #27ae60; }
   </string>
  </property>
