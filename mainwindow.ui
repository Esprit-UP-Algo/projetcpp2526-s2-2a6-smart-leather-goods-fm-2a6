  <property name="styleSheet">
   <string notr="true">/* --- THEME LEATHER FACTORY (BEIGE &amp; MARRON) --- */

/* 1. FOND GENERAL */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f1ea; /* Beige Crème très doux (Papier ancien) */
    font-family: &quot;Segoe UI&quot;, &quot;Verdana&quot;, sans-serif;
    color: #4e342e; /* Marron très foncé (presque noir) pour le texte */
    font-size: 14px;
}

/* 2. BARRE LATERALE (Marron Cuir Foncé) */
QFrame#frame_sidebar {
    background-color: #3e2723; /* Marron Chocolat profond */
    border-right: 1px solid #281a17;
    min-width: 230px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

/* LOGO et TEXTES SIDEBAR */
QLabel#label_logo {
    color: #ffffff;
    font-weight: bold;
    font-size: 18px;
    margin-bottom: 30px;
    background-color: rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 10px;
    border: 1px solid #5d4037;
}
QLabel#label_actions_title {
    color: #bcaaa4; /* Beige rosé pour les titres */
    font-weight: bold;
    text-transform: uppercase;
    font-size: 12px;
    margin-top: 20px;
    margin-bottom: 10px;
    padding-left: 10px;
}

/* BOUTONS SIDEBAR */
QPushButton.sidebar_btn {
    text-align: left;
    padding: 12px 20px;
    border: none;
    background-color: transparent;
    color: #efebe9; /* Blanc cassé */
    border-radius: 20px;
    font-weight: 500;
    margin-bottom: 5px;
}
QPushButton.sidebar_btn:hover {
    background-color: #5d4037; /* Marron plus clair au survol */
    color: #ffffff;
    padding-left: 25px; /* Animation */
    border-left: 3px solid #d7ccc8;
}
QPushButton.sidebar_btn:pressed {
    background-color: #281a17;
}

/* 3. ONGLETS (TabWidget) */
QTabWidget::pane { border: none; background: #f4f1ea; }
QTabBar::tab {
    background: #d7ccc8; /* Beige Taupe foncé */
    color: #5d4037;
    padding: 10px 25px;
    font-weight: bold;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    margin-right: 5px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #3e2723; /* Marron foncé */
    border-bottom: 3px solid #3e2723;
}
QTabBar::tab:hover { background-color: #e6ded8; color: #3e2723; }

/* 4. CARTES (Groupbox) */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d7ccc8; /* Bordure Taupe */
    border-radius: 15px;
    margin-top: 30px;
    font-weight: bold;
    color: #3e2723;
    padding: 20px;
    border-bottom: 3px solid #d7ccc8; /* Effet d'épaisseur */
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 20px;
    padding: 5px 10px;
    background-color: #efebe9; /* Fond très clair pour le titre */
    color: #5d4037;
    border-radius: 10px;
}

/* 5. CHAMPS DE SAISIE */
QLineEdit, QComboBox, QDateEdit, QDateTimeEdit, QDoubleSpinBox {
    background-color: #fffdf9; /* Blanc chaud */
    border: 1px solid #bcaaa4; /* Bordure marron clair */
    border-radius: 15px;
    padding: 6px 15px;
    color: #3e2723;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus {
    border: 2px solid #5d4037; /* Bordure marron foncé au focus */
    background-color: #ffffff;
}
QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 30px;
}

/* 6. BOUTONS ACTIONS */
QPushButton#btn_conflit, QPushButton#btn_calculer {
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 20px;
    padding: 10px 30px;
    font-size: 14px;
    border-bottom: 3px solid rgba(0,0,0,0.2);
}

/* Bouton Calculer (Marron Cuir) */
QPushButton#btn_calculer {
    background-color: #4e342e;
}
QPushButton#btn_calculer:hover { background-color: #5d4037; }

/* Bouton Conflit (Ocre / Rouille) */
QPushButton#btn_conflit {
    background-color: #bf360c;
}
QPushButton#btn_conflit:hover { background-color: #d84315; }

/* Bouton Créer Etape (Vert) */
QPushButton#btn_add_etape {
    background-color: #2e7d32;
    color: white;
    font-weight: bold;
    border-radius: 15px;
    padding: 8px 20px;
}

/* 7. TABLEAU (Style Clean) */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d7ccc8;
    border-radius: 10px;
    gridline-color: transparent;
    color: #3e2723;
    padding: 5px;
    alternate-background-color: #faf8f5; /* Lignes alternées crème */
}
QHeaderView::section {
    background-color: #8d6e63; /* Marron moyen (Cuir clair) */
    padding: 12px;
    border: none;
    font-weight: bold;
    color: #ffffff;
    border-radius: 0px;
}
QTableWidget::item:selected {
    background-color: #5d4037;
    color: white;
}

/* 8. ETIQUETTE STOCKAGE */
QLabel#lbl_stockage {
    background-color: #3e2723; /* Fond Marron foncé */
    color: #fff176; /* Jaune pâle (pour le contraste) */
    border-radius: 15px;
    padding: 10px;
    font-family: &quot;Consolas&quot;, monospace;
    font-weight: bold;
    border: 2px solid #5d4037;
}
</string>
