  <property name="styleSheet">
   <string notr="true">
    /* --- GLOBAL --- */
    QMainWindow, QWidget#centralwidget { background-color: #f3f0eb; font-family: &quot;Segoe UI&quot;; color: #3e2723; }
    QFrame#frame_sidebar { background-color: #1a1210; border-right: 1px solid #3e2723; min-width: 240px; max-width: 240px; }
    QWidget#widget_logo_container { background-color: #2c1a16; border-bottom: 2px solid #8d5524; }
    QLabel#l_app_title { color: #e0c097; font-size: 20px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }
    QPushButton.nav_btn { text-align: left; padding: 18px 25px; border: none; background: transparent; color: #aca09d; font-weight: 600; font-size: 14px; }
    QPushButton.nav_btn:hover { background-color: #3e2723; color: #fff; border-left: 4px solid #d4af37; padding-left: 29px; }
    QWidget#page_home { background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #2c1a16, stop:1 #1a1210); }
    QWidget#page_login { background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #2c1a16, stop:1 #1a1210); }
    QLabel#lbl_welcome_title { font-size: 56px; font-weight: 300; color: #ffffff; letter-spacing: 2px; }
    QLabel#lbl_welcome_sub { font-size: 22px; color: #d4af37; font-style: italic; margin-bottom: 50px; }
    QPushButton#btn_start_app { background-color: transparent; color: #d4af37; font-size: 18px; font-weight: bold; padding: 15px 50px; border: 2px solid #d4af37; border-radius: 4px; text-transform: uppercase; }
    QPushButton#btn_start_app:hover { background-color: #d4af37; color: #1a1210; }

    /* --- LOGIN PAGE --- */
    QFrame#login_card { background: rgba(255,255,255,0.06); border: 1px solid rgba(212,175,55,0.35); border-radius: 16px; }
    QLabel#lbl_login_title { font-size: 34px; font-weight: 700; color: #ffffff; letter-spacing: 1px; }
    QLabel#lbl_login_sub { font-size: 16px; color: #d4af37; font-style: italic; }
    QLineEdit#le_login_nom, QLineEdit#le_login_prenom, QLineEdit#le_login_mdp {
        background: rgba(255,255,255,0.92);
        border: 1px solid rgba(212,175,55,0.55);
        padding: 12px;
        border-radius: 10px;
        font-size: 14px;
        color: #2c1a16;
    }
    QPushButton#btn_login {
        background-color: #d4af37;
        color: #1a1210;
        padding: 12px 26px;
        border-radius: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }
    QPushButton#btn_login:hover { background-color: #e0c097; }
    QPushButton#btn_login_back {
        background-color: transparent;
        color: #d4af37;
        border: 1px solid #d4af37;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 800;
    }
    QPushButton#btn_login_back:hover { background-color: rgba(212,175,55,0.12); }
    QTableWidget { background-color: #ffffff; gridline-color: #ecf0f1; border: 1px solid #dcdcdc; border-radius: 4px; }
    QHeaderView::section { background-color: #2c1a16; color: #e0c097; padding: 12px; border: none; font-weight: bold; text-transform: uppercase; }
    QTableWidget::item { border-bottom: 1px solid #f0f0f0; padding: 5px; }
    QTableWidget#tableTimeline::item { background-color: transparent; border: 0px; }
    QPushButton { border-radius: 4px; padding: 8px 16px; font-weight: bold; border: none; }

    /* Boutons Or */
    QPushButton#btn_to_add_planif, QPushButton#btn_valider_planif, QPushButton#btn_calculer_ia, QPushButton#btn_valider_etape,
    QPushButton#btn_add_produit, QPushButton#btn_valider_produit, QPushButton#btn_add_emp, QPushButton#btn_valider_emp, QPushButton#btn_send_chat,
    QPushButton#btn_add_stock, QPushButton#btn_valider_stock, QPushButton#btn_calculer_besoin, QPushButton#btn_compare_stock,
    QPushButton#btn_add_client, QPushButton#btn_valider_client,
    QPushButton#btn_add_depot, QPushButton#btn_valider_depot {
        background-color: #8d5524; color: white;
    }
    QPushButton#btn_to_add_planif:hover, QPushButton#btn_add_produit:hover { background-color: #a0673b; }

    /* Boutons Marron */
    QPushButton#btn_rechercher, QPushButton#btn_tri, QPushButton#btn_sort_alpha_planif, QPushButton#btn_stat_plan, QPushButton#btn_modifier_planif, QPushButton#btn_pdf,
    QPushButton#btn_back_planif, QPushButton#btn_back_fab, QPushButton#btn_back_stats, QPushButton#btn_refresh_timeline,
    QPushButton#btn_edit_produit, QPushButton#btn_search_col, QPushButton#btn_sort_alpha_prod, QPushButton#btn_pdf_catalogue,
    QPushButton#btn_back_prod, QPushButton#btn_stats_prod, QPushButton#btn_back_stats_prod,
    QPushButton#btn_edit_emp, QPushButton#btn_search_emp, QPushButton#btn_sort_alpha_emp, QPushButton#btn_sort_anciennete, QPushButton#btn_pdf_emp, QPushButton#btn_stats_emp, QPushButton#btn_stats_emp_stats, QPushButton#btn_back_emp, QPushButton#btn_calcul_score, QPushButton#btn_back_stats_emp,
    QPushButton#btn_edit_stock, QPushButton#btn_search_stock, QPushButton#btn_sort_alpha_stock, QPushButton#btn_pdf_stock, QPushButton#btn_saisie_detail, QPushButton#btn_back_stock, QPushButton#btn_back_inn_stock,
    QPushButton#btn_stats_stock, QPushButton#btn_back_stats_stock,
    QPushButton#btn_search_client, QPushButton#btn_sort_alpha_client, QPushButton#btn_sort_fidelite, QPushButton#btn_stats_client, QPushButton#btn_pdf_facture, QPushButton#btn_back_client, QPushButton#btn_back_stats_client, QPushButton#btn_edit_client,
    QPushButton#btn_search_depot, QPushButton#btn_sort_alpha_depot, QPushButton#btn_sort_remplissage, QPushButton#btn_stats_depot, QPushButton#btn_pdf_depot, QPushButton#btn_back_depot, QPushButton#btn_back_stats_depot, QPushButton#btn_edit_depot {
        background-color: #795548; color: white;
    }
    QPushButton#btn_check_delta, QPushButton#btn_supprimer_planif, QPushButton#btn_delete_produit, QPushButton#btn_delete_emp, QPushButton#btn_delete_stock, QPushButton#btn_delete_client, QPushButton#btn_delete_depot { background-color: #b71c1c; color: white; }

    /* Boutons Spéciaux Innovations */
    QPushButton#btn_open_compare { background-color: #00838f; color: white; }
    QPushButton#btn_open_calcul { background-color: #f9a825; color: white; }
    QPushButton#btn_cout_produit { background-color: #00897b; color: white; }
    QPushButton#btn_hist_mode { background-color: #7b1fa2; color: white; }
    QPushButton#btn_open_eval { background-color: #ef6c00; color: white; }

    QPushButton#btn_open_optimize { background-color: #00838f; color: white; }
    QPushButton#btn_open_ravit { background-color: #f9a825; color: white; }
    QPushButton#btn_open_fidelite { background-color: #00897b; color: white; }

    /* NOUVEAU BOUTON PLANIF IA (Violet) */
    QPushButton#btn_open_planif_ia { background-color: #7b1fa2; color: white; }

    QPushButton#btn_open_client_ia { background-color: #7b1fa2; color: white; }

    QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox { background: #ffffff; border: 1px solid #ccc; padding: 8px; border-radius: 4px; color: #333; }
    QLabel#lbl_iot_temp, QLabel.lbl_kpi_inn { color: #d84315; font-weight:bold; border: 2px solid #d84315; padding:8px; border-radius:6px; background:white; font-size:14px; }
    QLabel#lbl_iot_hum { color: #0277bd; font-weight:bold; border: 2px solid #0277bd; padding:8px; border-radius:6px; background:white; }
    QTextBrowser { background-color: #fff; border: 1px solid #dcdcdc; border-radius: 8px; padding: 10px; font-size: 14px; }
    /* --- DASHBOARD STATS (style like screenshot) --- */
    QLabel#lbl_title_s, QLabel#lbl_title_sp, QLabel#lbl_title_sst, QLabel#lbl_title_sc, QLabel#lbl_title_sd, QLabel#lbl_title_se {
        background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2c1a16, stop:1 #795548);
        color: #ffffff;
        border-radius: 14px;
        padding: 18px;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    QFrame.stat_card {
        border-radius: 14px;
        border: none;
        padding: 12px;
        background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #2c1a16, stop:1 #1a1210);
    }
    QFrame.stat_card QLabel { color: #ffffff; font-weight: 700; }
    QLabel.stat_val { font-size: 34px; font-weight: 900; color: #ffffff; }

    /* KPI gradients (reuse existing palette colors already used in the app) */
    QFrame#st1, QFrame#stp1, QFrame#st_rh1, QFrame#st_cli1, QFrame#st_dep1, QFrame#st_stk1 {
        background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #27ae60, stop:1 #00897b);
    }
    QFrame#st2, QFrame#stp2, QFrame#st_rh2, QFrame#st_cli2, QFrame#st_dep2, QFrame#st_stk2 {
        background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #0277bd, stop:1 #00838f);
    }
    QFrame#st3, QFrame#stp3, QFrame#st_rh3, QFrame#st_cli3, QFrame#st_dep3, QFrame#st_stk3 {
        background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #ef6c00, stop:1 #f9a825);
    }

    /* Stats groupboxes only (keep forms unchanged) */
    QGroupBox#gb_charts, QGroupBox#gb_charts_statut, QGroupBox#gb_chart_coll, QGroupBox#gb_chart_cuir,
    QGroupBox#gb_chart_cat, QGroupBox#gb_chart_qual, QGroupBox#gb_geo_cli, QGroupBox#gb_fidel_cli,
    QGroupBox#gb_type_dep, QGroupBox#gb_fill_dep, QGroupBox#gb_chart_dept, QGroupBox#gb_chart_poste {
        background: #ffffff;
        border: 2px solid #d7ccc8;
        border-radius: 12px;
        margin-top: 10px;
        padding: 12px;
        font-weight: 700;
    }
    QGroupBox#gb_charts::title, QGroupBox#gb_charts_statut::title, QGroupBox#gb_chart_coll::title, QGroupBox#gb_chart_cuir::title,
    QGroupBox#gb_chart_cat::title, QGroupBox#gb_chart_qual::title, QGroupBox#gb_geo_cli::title, QGroupBox#gb_fidel_cli::title,
    QGroupBox#gb_type_dep::title, QGroupBox#gb_fill_dep::title, QGroupBox#gb_chart_dept::title, QGroupBox#gb_chart_poste::title {
        subcontrol-origin: margin;
        left: 12px;
        padding: 0 6px;
        color: #8d5524;
    }

    QProgressBar { border: 1px solid #d7ccc8; border-radius: 9px; text-align: center; background: #f3f0eb; color:#3e2723; height: 18px; font-weight: 700; }
    QProgressBar::chunk { border-radius: 9px; background-color: #27ae60; }

    /* Per-bar colors (dashboard look) */
    QProgressBar#pb_cuir::chunk { background-color: #0277bd; }
    QProgressBar#pb_teint::chunk { background-color: #ef6c00; }
    QProgressBar#pb_chim::chunk { background-color: #27ae60; }
    QProgressBar#pb_qa::chunk { background-color: #f9a825; }
    QProgressBar#pb_qb::chunk { background-color: #90a4ae; }
    QProgressBar#pb_qc::chunk { background-color: #8d5524; }

    /* Dashboard actions */
    QPushButton.btn_excel { background-color: #27ae60; color: white; border-radius: 18px; padding: 10px 18px; }
    QPushButton.btn_excel:hover { background-color: #00897b; }
    QPushButton.btn_print { background-color: #0277bd; color: white; border-radius: 18px; padding: 10px 18px; }
    QPushButton.btn_print:hover { background-color: #00838f; }
    QPushButton.btn_close { background-color: #3e2723; color: white; border-radius: 18px; padding: 10px 18px; }
    QPushButton.btn_close:hover { background-color: #1a1210; }
