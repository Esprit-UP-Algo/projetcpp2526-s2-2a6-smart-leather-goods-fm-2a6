  <property name="windowTitle">
   <string>Smart Leather Factory - ERP Global (Version Finale)</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* --- THEME SMART LEATHER (V6 FINAL - TOUT INCLUS) --- */

/* 1. FOND GENERAL */
QMainWindow, QWidget#centralwidget {
    background-color: #f4f1ea; /* Beige Crème */
    font-family: &quot;Segoe UI&quot;, &quot;Verdana&quot;, sans-serif;
    color: #4e342e; /* Marron très foncé */
    font-size: 14px;
}

/* 2. BARRE LATERALE */
QFrame#frame_sidebar {
    background-color: #3e2723; /* Marron Chocolat */
    border-right: 1px solid #281a17;
    min-width: 230px;
}
QLabel#label_logo {
    color: #ffffff;
    font-weight: bold;
    font-size: 18px;
    margin-bottom: 30px;
    background-color: rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 10px;
    border: 1px solid #5d4037;
}
QLabel#label_actions_title {
    color: #bcaaa4;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 12px;
    margin-top: 20px;
    margin-bottom: 10px;
    padding-left: 10px;
}

/* BOUTONS SIDEBAR */
QPushButton.sidebar_btn {
    text-align: left;
    padding: 12px 20px;
    border: none;
    background-color: transparent;
    color: #efebe9;
    border-radius: 20px;
    font-weight: 500;
    margin-bottom: 5px;
}
QPushButton.sidebar_btn:hover {
    background-color: #5d4037;
    color: #ffffff;
    padding-left: 25px;
    border-left: 3px solid #d7ccc8;
}
QPushButton.sidebar_btn:pressed { background-color: #281a17; }

/* 3. ONGLETS */
QTabWidget::pane { border: none; background: #f4f1ea; }
QTabBar::tab {
    background: #d7ccc8;
    color: #5d4037;
    padding: 10px 25px;
    font-weight: bold;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    margin-right: 5px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #3e2723;
    border-bottom: 3px solid #3e2723;
}
QTabBar::tab:hover { background-color: #e6ded8; color: #3e2723; }

/* 4. CARTES (Groupbox) */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d7ccc8;
    border-radius: 15px;
    margin-top: 30px;
    font-weight: bold;
    color: #3e2723;
    padding: 20px;
    border-bottom: 3px solid #d7ccc8;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 5px 10px;
    background-color: #efebe9;
    color: #5d4037;
    border-radius: 10px;
}

/* 5. CHAMPS DE SAISIE */
QLineEdit, QComboBox, QDateEdit, QDateTimeEdit, QSpinBox, QDoubleSpinBox, QTimeEdit, QTextEdit {
    background-color: #fffdf9;
    border: 1px solid #bcaaa4;
    border-radius: 15px;
    padding: 6px 15px;
    color: #3e2723;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus, QTextEdit:focus {
    border: 2px solid #5d4037;
    background-color: #ffffff;
}

/* 6. BOUTONS ACTIONS COMMUNS */
QPushButton#btn_conflit, QPushButton#btn_calculer, QPushButton#btn_opti, QPushButton#btn_cump, QPushButton#btn_compare, QPushButton#btn_besoin,
QPushButton#btn_qr, QPushButton#btn_hist, QPushButton#btn_ai_opti,
QPushButton#btn_vocal, QPushButton#btn_rfid_scan, QPushButton#btn_tri_anc,
QPushButton#btn_mailing, QPushButton#btn_facture, QPushButton#btn_tri_points {
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 20px;
    padding: 10px 25px;
    font-size: 13px;
    border-bottom: 3px solid rgba(0,0,0,0.2);
}

/* Couleurs Spécifiques */
QPushButton#btn_calculer, QPushButton#btn_tri_anc, QPushButton#btn_tri_points { background-color: #4e342e; }
QPushButton#btn_calculer:hover, QPushButton#btn_tri_anc:hover, QPushButton#btn_tri_points:hover { background-color: #5d4037; }

QPushButton#btn_conflit { background-color: #bf360c; }
QPushButton#btn_conflit:hover { background-color: #d84315; }

QPushButton#btn_opti, QPushButton#btn_ai_opti { background-color: #2e7d32; }
QPushButton#btn_opti:hover, QPushButton#btn_ai_opti:hover { background-color: #388e3c; }

QPushButton#btn_cump, QPushButton#btn_besoin, QPushButton#btn_facture { background-color: #f9a825; }
QPushButton#btn_cump:hover, QPushButton#btn_besoin:hover, QPushButton#btn_facture:hover { background-color: #fbc02d; }

QPushButton#btn_compare, QPushButton#btn_hist, QPushButton#btn_vocal, QPushButton#btn_mailing { background-color: #00838f; }
QPushButton#btn_compare:hover, QPushButton#btn_hist:hover, QPushButton#btn_vocal:hover, QPushButton#btn_mailing:hover { background-color: #0097a7; }

QPushButton#btn_qr { background-color: #212121; }
QPushButton#btn_qr:hover { background-color: #424242; }

QPushButton#btn_rfid_scan { background-color: #6a1b9a; }
QPushButton#btn_rfid_scan:hover { background-color: #8e24aa; }

/* 7. TABLEAUX */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d7ccc8;
    border-radius: 10px;
    gridline-color: transparent;
    color: #3e2723;
    padding: 5px;
    alternate-background-color: #faf8f5;
}
QHeaderView::section {
    background-color: #8d6e63;
    padding: 12px;
    border: none;
    font-weight: bold;
    color: #ffffff;
}
QTableWidget::item:selected {
    background-color: #5d4037;
    color: white;
}

/* 8. LABELS SPECIAUX (IoT/Score/Statut) */
QLabel#lbl_stockage, QLabel#lbl_valeur_stock, QLabel#lbl_iot_temp, QLabel#lbl_iot_hum, QLabel#lbl_arduino_prod, QLabel#lbl_score_emp, QLabel#lbl_statut_client, QLabel#lbl_ia_prevision {
    background-color: #3e2723;
    color: #fff176;
    border-radius: 15px;
    padding: 10px;
    font-family: &quot;Consolas&quot;, monospace;
    font-weight: bold;
    border: 2px solid #5d4037;
    text-align: center;
}
QLabel#lbl_fire_status, QLabel#lbl_rfid_status {
    background-color: #2e7d32;
    color: white;
    font-weight: bold;
    border-radius: 10px;
    padding: 8px;
    text-align: center;
}

/* 9. STYLE CHATBOT SPECIFIQUE */
QTextEdit#chatOutput {
    background-color: #faf8f5;
    border: 2px solid #d7ccc8;
    font-size: 13px;
    line-height: 1.5;
}

QLineEdit#chatInput {
    background-color: #ffffff;
    border: 2px solid #d7ccc8;
    font-size: 14px;
}

QPushButton#sendButton {
    background-color: #2e7d32;
    transition: 0.3s;
}

QPushButton#sendButton:hover {
    background-color: #388e3c;
    transform: scale(1.02);
}
</string>
